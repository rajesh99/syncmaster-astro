    "award": {
      "enable": false,
      "title": "",
      "badges": []
    },
    "contact_form_action": "#"
  },

  "navigation_button": {
    "enable": true,
    "label": "Sign in",
    "link": "https://app.multinudge.com/auth/sign-in"
  },

  "navigation_button2": {
    "enable": true,
    "label": "Sign up",
    "link": "https://app.multinudge.com/auth/sign-up"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "metadata": {
    "meta_author": "themefisher",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind saas theme"
  }
