{
  "site": {
    "title": "MultiNudge",
    "base_url": "https://syncmaster-astro.vercel.app/",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/logo.svg",
    "logo_darkmode": "/images/logo_darkmode.svg",
    "logo_width": "229",
    "logo_height": "45",
    "logo_text": "MultiNudge"
  },

  "settings": {
