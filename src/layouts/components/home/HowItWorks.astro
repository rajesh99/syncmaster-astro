---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  how_it_works: CollectionEntry<"homepage">["data"]["how_it_works"];
}
const { how_it_works } = Astro.props;

if (!how_it_works) {
  return null;
}
---

<section id="how-it-works" class="section">
  <div class="container">
    <div class="row justify-center mb-12">
      <div class="col-12 sm:col-10 text-center">
        <h2
          set:html={markdownify(how_it_works.title)}
          class="lg:h1 mb-4"
          data-aos="fade-up-sm"
        />
      </div>
    </div>
    
    <div class="row g-6 justify-center">
      {
        how_it_works.steps.map((step, index) => (
          <div class="col-12 md:col-6 lg:col-4">
            <div
              class="bg-light rounded-3xl p-6 sm:p-8 h-full relative"
              data-aos="fade-up-sm"
              data-aos-delay={index * 100}
            >
              <!-- Step Number Badge -->
              <div class="absolute -top-4 -left-4 w-12 h-12 bg-primary text-light rounded-full flex items-center justify-center font-bold text-xl">
                {step.step_number}
              </div>
              
              <h3
                set:html={markdownify(step.title)}
                class="text-2xl font-bold mb-4 mt-2"
              />
              
              {step.description && (
                <p class="mb-6 text-text-dark/70">
                  {step.description}
                </p>
              )}
              
              {step.sections && step.sections.length > 0 && (
                <div class="space-y-6">
                  {
                    step.sections.map((section) => (
                      <div>
                        {section.title && (
                          <h4
                            set:html={markdownify(section.title)}
                            class="text-lg font-semibold mb-3"
                          />
                        )}
                        <ul class="space-y-2">
                          {section.items.map((item) => (
                            <li class="flex items-start gap-3">
                              <div class="mt-2 rounded-full aspect-square w-2 bg-secondary shrink-0" />
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))
                  }
                </div>
              )}
              
              <!-- Time Badge -->
              <div class="mt-6 pt-6 border-t border-border/20">
                <p class="text-sm font-semibold text-primary">
                  Time: {step.time}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

