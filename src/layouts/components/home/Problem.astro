---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  problem: CollectionEntry<"homepage">["data"]["problem"];
}
const { problem } = Astro.props;

if (!problem) {
  return null;
}
---

<section class="section">
  <div class="container">
    <div class="row justify-center mb-12">
      <div class="col-12 sm:col-10 text-center">
        <h2
          set:html={markdownify(problem.title)}
          class="lg:h1 mb-4"
          data-aos="fade-up-sm"
        />
      </div>
    </div>
    
    <div class="row g-4">
      <!-- Left Column: The Daily Grind -->
      <div class="col-12 lg:col-6">
        <div
          class="bg-light rounded-3xl p-6 sm:p-8 h-full"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          <h3
            set:html={markdownify(problem.left_column.title)}
            class="text-2xl font-bold mb-6"
          />
          {
            problem.left_column.sections.map((section) => (
              <div class="mb-8 last:mb-0">
                <h4
                  set:html={markdownify(section.title)}
                  class="text-lg font-semibold mb-3"
                />
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li class="flex items-start gap-3">
                      <div class="mt-2 rounded-full aspect-square w-2 bg-secondary shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      
      <!-- Right Column: The Real Cost -->
      <div class="col-12 lg:col-6">
        <div
          class="bg-primary/5 rounded-3xl p-6 sm:p-8 h-full"
          data-aos="fade-up-sm"
          data-aos-delay="200"
        >
          <h3
            set:html={markdownify(problem.right_column.title)}
            class="text-2xl font-bold mb-6"
          />
          {
            problem.right_column.sections.map((section) => (
              <div class="mb-8 last:mb-0">
                <h4
                  set:html={markdownify(section.title)}
                  class="text-lg font-semibold mb-3"
                />
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li class="flex items-start gap-3">
                      <div class="mt-2 rounded-full aspect-square w-2 bg-secondary shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

