---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  solution: CollectionEntry<"homepage">["data"]["solution"];
}
const { solution } = Astro.props;

if (!solution) {
  return null;
}
---

<section class="section bg-tertiary">
  <div class="container">
    <div class="row justify-center mb-12">
      <div class="col-12 sm:col-10 lg:col-8 text-center">
        <h2
          set:html={markdownify(solution.title)}
          class="lg:h1 mb-6"
          data-aos="fade-up-sm"
        />
        <p
          set:html={markdownify(solution.content)}
          class="text-lg mb-12"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        />
      </div>
    </div>
    
    <div class="row g-4 justify-center">
      {
        solution.columns.map((column, index) => (
          <div class="col-12 md:col-6 lg:col-4">
            <div
              class="bg-body rounded-3xl p-6 sm:p-8 h-full text-center"
              data-aos="fade-up-sm"
              data-aos-delay={100 + index * 100}
            >
              <h3
                set:html={markdownify(column.title)}
                class="text-xl font-bold mb-6"
              />
              <ul class="space-y-3 text-left">
                {column.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <div class="mt-2 rounded-full aspect-square w-2 bg-secondary shrink-0" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

