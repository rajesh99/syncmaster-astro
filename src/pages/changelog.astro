---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

const changelogIndex = await getListPage ("changelog", "-index");
if (changelogIndex.data.draft) {
  return Astro.redirect("/404");
}
const { title, meta_title, description, content } = changelogIndex.data;

const { Content } = await render(changelogIndex);
---

<Base title={title} meta_title={meta_title} description={description}>
  <PageHeader title={title} content={content} />

  <section class="-mt-14">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 lg:col-10">
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
