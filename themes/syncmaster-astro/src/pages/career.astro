---
import Slider from "@/components/career/Slider.astro";
import About from "@/components/company/About.astro";
import Job from "@/components/company/Job.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";

const careerIndex = await getListPage("career", "-index");
if(careerIndex.data.draft){
  return Astro.redirect("/404");
}
const { hero, about, slider, } = careerIndex.data;
---

<Base {...careerIndex.data}>
  <PageHeader title={hero.title} content={hero.content} />

  <About {about} />
  <Slider {slider} />

  <Job />
  <CallToAction />
</Base>
