---
import CaseCard from "@/components/CaseCard.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";

const caseIndex = await getListPage("case", "-index");
if (caseIndex.data.draft) {
  return Astro.redirect("/404");
}
const { title, meta_title, description, hero } = caseIndex.data;
const cases = await getSinglePage("case");
---

<Base title={title} meta_title={meta_title} description={description}>
  {hero && <PageHeader title={hero.title} content={hero.content} />}

  <section class="-mt-28">
    <div class="container xl:w-[46%]">
      <div class="mx-auto row g-5 justify-center">
        {
          cases.map((caseStudy, i: number) => (
            <div class="col-12 md:col-6 max-md:px-0 min-h-full">
              <div
                class="h-full flex flex-col justify-between"
                data-aos="fade-up-sm"
                data-aos-delay={`${i * 100}`}
              >
                <CaseCard data={caseStudy} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction  />
</Base>
